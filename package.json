{
  "name": "permit-admin-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm --workspace packages/permitAdminAPI run dev\" \"npm --workspace packages/permitAdminAPP run dev\"",
    "api": "npm --workspace packages/permitAdminAPI run dev",
    "app": "npm --workspace packages/permitAdminAPP run dev",
    "build": "npm --workspace packages/permitAdminAPP run build",
    "test": "npm run test --workspaces"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
